# ---- Children feed (internal Sponsorship Hub) ----
NEXT_PUBLIC_CHILDREN_FEED=https://uborahomevisit.co.tz/sponsor-feed/children

# ---- Webflow live nav + footer pull ----
# The noindex page that exposes only #global-nav and #global-footer.
WEBFLOW_NAVFOOTER_URL=https://uboratz.org/navigation-footer-pull
# The origin that relative links (/give) should be rewritten to.
WEBFLOW_SITE_ORIGIN=https://uboratz.org
# How long (seconds) to cache the nav/footer before refetching. The publish webhook clears it instantly.
NAVFOOTER_TTL=3600

# ---- Publish webhook secret ----
# Naum calls https://<site>/api/webflow-publish?secret=THIS on every Webflow publish to clear the cache.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---- Virtuous giving form (same values your boss provided) ----
NEXT_PUBLIC_VIRTUOUS_SRC=https://cdn.virtuoussoftware.com/virtuous.embed.min.js
NEXT_PUBLIC_VIRTUOUS_VFORM=727C0E0A-C6EA-4FB1-BCA2-5E4744A6248D
NEXT_PUBLIC_VIRTUOUS_ORGID=7019
NEXT_PUBLIC_VIRTUOUS_ISGIVING=true
NEXT_PUBLIC_VIRTUOUS_MERCHANTTYPE=StripeUnified
NEXT_PUBLIC_VIRTUOUS_DEPENDENCIES=[0]
